DATABASE_URL=postgresql://mekan:mekan_local_only@localhost:5432/mekan?schema=public
APP_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME=Mekan AI
STORAGE_DRIVER=local
STORAGE_PATH=.storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=mekan-private
S3_ACCESS_KEY_ID=mekan_local
S3_SECRET_ACCESS_KEY=change-this-local-secret
AI_PROVIDER=local
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
AI_COST_ESTIMATE_AZN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Mekan AI <noreply@example.com>
REQUIRE_EMAIL_VERIFICATION=false
SEED_DEMO_PASSWORD=

# Local model: no paid API and no platform credit deduction.
ALLOW_PAID_AI=false
LOCAL_AI_URL=http://127.0.0.1:7861
LOCAL_AI_TOKEN=replace-with-a-random-local-secret
LOCAL_AI_MODEL=stable-diffusion-v1-5/stable-diffusion-v1-5

# Paid providers stay disabled; the 2D editor never invokes inference.
PAID_AI_ENABLED=false
