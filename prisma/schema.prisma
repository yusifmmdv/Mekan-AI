generator client {
  provider = "prisma-client"
  output = "../generated/prisma"
}
datasource db {
  provider = "postgresql"
}
enum Role {
 CUSTOMER
 REALTOR
 STORE_OWNER
 DESIGNER
 ADMIN
}
enum Approval {
 PENDING
 APPROVED
 REJECTED
}
enum ProductStatus {
 DRAFT
 PENDING
 ACTIVE
 REJECTED
 ARCHIVED
}
enum JobStatus {
 QUEUED
 PROCESSING
 SUCCEEDED
 FAILED
}
enum RequestStatus {
 NEW
 ACCEPTED
 IN_PROGRESS
 COMPLETED
 CANCELLED
}
enum PaymentStatus {
 PENDING
 CONFIRMED
 REJECTED
}
model User {
 id String @id @default(cuid())
 email String @unique
 passwordHash String
 name String
 role Role @default(CUSTOMER)
 emailVerified DateTime?
 disabled Boolean @default(false)
 demo Boolean @default(false)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 accounts Account[]
 sessions Session[]
 tokens AuthToken[]
 profile Profile?
 store Store?
 designer DesignerProfile?
 favorites Favorite[]
 cart Cart?
 orders Order[]
 inquiries Inquiry[]
 projects DesignProject[]
 properties Property[]
 staging VirtualStagingProject[]
 wallet CreditWallet?
 subscriptions Subscription[]
 payments Payment[]
 requests DesignerRequest[]
 notifications Notification[]
 auditLogs AuditLog[]
 assets ImageAsset[]
 roomDesigns RoomDesign[]
 reports Report[]
}
model Account {
 id String @id @default(cuid())
 userId String
 provider String
 providerAccountId String
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 @@unique([provider,providerAccountId])
}
model Session {
 id String @id @default(cuid())
 tokenHash String @unique
 userId String
 expiresAt DateTime
 createdAt DateTime @default(now())
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 @@index([userId])
 @@index([expiresAt])
}
model AuthToken {
 id String @id @default(cuid())
 userId String
 tokenHash String @unique
 kind String
 expiresAt DateTime
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 @@index([userId,kind])
}
model Profile {
 id String @id @default(cuid())
 userId String @unique
 phone String?
 city String @default("Bakı")
 locale String @default("az")
 bio String?
 updatedAt DateTime @updatedAt
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
}
model Store {
 id String @id @default(cuid())
 ownerId String @unique
 name String
 slug String @unique
 description String
 phone String
 email String
 address String
 logoAssetId String?
 approval Approval @default(PENDING)
 demo Boolean @default(false)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 owner User @relation(fields:[ownerId],references:[id])
 logo ImageAsset? @relation(fields:[logoAssetId],references:[id])
 products Product[]
 inquiries Inquiry[]
 orders Order[]
 @@index([approval])
}
model ProductCategory {
 id String @id @default(cuid())
 name String
 slug String @unique
 products Product[]
}
model Product {
 id String @id @default(cuid())
 storeId String
 categoryId String
 name String
 slug String @unique
 description String
 price Decimal @db.Decimal(12,2)
 discountPrice Decimal? @db.Decimal(12,2)
 currency String @default("AZN")
 brand String?
 width Float?
 height Float?
 depth Float?
 materials String[]
 colors String[]
 tags String[]
 roomTypes String[]
 styles String[]
 stock Int @default(0)
 sku String
 status ProductStatus @default(PENDING)
 demo Boolean @default(false)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 store Store @relation(fields:[storeId],references:[id])
 category ProductCategory @relation(fields:[categoryId],references:[id])
 images ProductImage[]
 favorites Favorite[]
 cartItems CartItem[]
 orderItems OrderItem[]
 inquiries Inquiry[]
 events AnalyticsEvent[]
 @@unique([storeId,sku])
 @@index([status,categoryId,price])
 @@index([storeId,status])
}
model ProductImage {
 id String @id @default(cuid())
 productId String
 assetId String?
 url String?
 alt String
 position Int @default(0)
 product Product @relation(fields:[productId],references:[id],onDelete:Cascade)
 asset ImageAsset? @relation(fields:[assetId],references:[id])
 @@index([productId,position])
}
model ImageAsset {
 id String @id @default(cuid())
 ownerId String
 key String @unique
 mime String
 size Int
 width Int
 height Int
 purpose String
 createdAt DateTime @default(now())
 owner User @relation(fields:[ownerId],references:[id])
 products ProductImage[]
 stores Store[]
 projects DesignProject[]
 results DesignGeneration[]
 propertyImages PropertyImage[]
 roomDesigns RoomDesign[]
 portfolio PortfolioItem[]
 @@index([ownerId,purpose])
}
model Favorite {
 userId String
 productId String
 createdAt DateTime @default(now())
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 product Product @relation(fields:[productId],references:[id],onDelete:Cascade)
 @@id([userId,productId])
}
model Cart {
 id String @id @default(cuid())
 userId String @unique
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 items CartItem[]
}
model CartItem {
 id String @id @default(cuid())
 cartId String
 productId String
 quantity Int
 cart Cart @relation(fields:[cartId],references:[id],onDelete:Cascade)
 product Product @relation(fields:[productId],references:[id])
 @@unique([cartId,productId])
}
model Order {
 id String @id @default(cuid())
 userId String
 storeId String
 status RequestStatus @default(NEW)
 total Decimal @db.Decimal(12,2)
 currency String @default("AZN")
 contact String
 note String?
 idempotencyKey String @unique
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 user User @relation(fields:[userId],references:[id])
 store Store @relation(fields:[storeId],references:[id])
 items OrderItem[]
 @@index([storeId,status])
 @@index([userId,createdAt])
}
model OrderItem {
 id String @id @default(cuid())
 orderId String
 productId String
 quantity Int
 unitPrice Decimal @db.Decimal(12,2)
 productName String
 order Order @relation(fields:[orderId],references:[id],onDelete:Cascade)
 product Product @relation(fields:[productId],references:[id])
}
model Inquiry {
 projectId String?
 project DesignProject? @relation(fields:[projectId],references:[id])
 id String @id @default(cuid())
 userId String
 storeId String
 productId String?
 message String
 reply String?
 status RequestStatus @default(NEW)
 createdAt DateTime @default(now())
 user User @relation(fields:[userId],references:[id])
 store Store @relation(fields:[storeId],references:[id])
 product Product? @relation(fields:[productId],references:[id])
 @@index([storeId,status])
}
model DesignProject {
 galleryIds String[] @default([])
 spaceType String @default("HOME")
 inquiries Inquiry[]
 serviceRequests DesignerRequest[]
 id String @id @default(cuid())
 userId String
 title String
 imageId String
 roomType String
 style String
 width Float
 length Float
 colors String[]
 requirements String
 budget Decimal @db.Decimal(12,2)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 user User @relation(fields:[userId],references:[id])
 image ImageAsset @relation(fields:[imageId],references:[id])
 generations DesignGeneration[]
 staging VirtualStagingProject?
 @@index([userId,createdAt])
}
model DesignGeneration {
 analysisStatus String @default("NONE")
 analysisError String?
 analysisLockedAt DateTime?
 analysis Json?
 id String @id @default(cuid())
 projectId String
 status JobStatus @default(QUEUED)
 idempotencyKey String @unique
 outputImageId String?
 provider String
 model String
 prompt String
 error String?
 attempts Int @default(0)
 lockedAt DateTime?
 credits Int @default(1)
 estimatedCostAzn Decimal? @db.Decimal(12,4)
 actualCostAzn Decimal? @db.Decimal(12,4)
 metadata Json?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 project DesignProject @relation(fields:[projectId],references:[id])
 outputImage ImageAsset? @relation(fields:[outputImageId],references:[id])
 @@index([status,createdAt])
 @@index([projectId,createdAt])
}
model Property {
 id String @id @default(cuid())
 userId String
 title String
 location String
 type String
 roomCount Int
 area Float
 description String
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 user User @relation(fields:[userId],references:[id])
 images PropertyImage[]
 projects VirtualStagingProject[]
 @@index([userId])
}
model PropertyImage {
 id String @id @default(cuid())
 propertyId String
 assetId String
 property Property @relation(fields:[propertyId],references:[id],onDelete:Cascade)
 asset ImageAsset @relation(fields:[assetId],references:[id])
 @@unique([propertyId,assetId])
}
model VirtualStagingProject {
 id String @id @default(cuid())
 userId String
 propertyId String
 designProjectId String @unique
 createdAt DateTime @default(now())
 user User @relation(fields:[userId],references:[id])
 property Property @relation(fields:[propertyId],references:[id])
 designProject DesignProject @relation(fields:[designProjectId],references:[id])
 @@index([userId,propertyId])
}
model DesignerProfile {
 id String @id @default(cuid())
 userId String @unique
 displayName String
 slug String @unique
 bio String
 city String
 available Boolean @default(true)
 approval Approval @default(PENDING)
 demo Boolean @default(false)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 user User @relation(fields:[userId],references:[id])
 services DesignerService[]
 portfolio PortfolioItem[]
 requests DesignerRequest[]
}
model PortfolioItem {
 id String @id @default(cuid())
 designerId String
 assetId String
 title String
 designer DesignerProfile @relation(fields:[designerId],references:[id],onDelete:Cascade)
 asset ImageAsset @relation(fields:[assetId],references:[id])
}
model DesignerService {
 id String @id @default(cuid())
 designerId String
 title String
 description String
 price Decimal @db.Decimal(12,2)
 active Boolean @default(true)
 createdAt DateTime @default(now())
 designer DesignerProfile @relation(fields:[designerId],references:[id])
 requests DesignerRequest[]
 @@index([designerId,active])
}
model DesignerRequest {
 projectId String?
 project DesignProject? @relation(fields:[projectId],references:[id])
 id String @id @default(cuid())
 userId String
 designerId String
 serviceId String
 brief String
 contact String
 reply String?
 quotedPrice Decimal @db.Decimal(12,2)
 status RequestStatus @default(NEW)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 user User @relation(fields:[userId],references:[id])
 designer DesignerProfile @relation(fields:[designerId],references:[id])
 service DesignerService @relation(fields:[serviceId],references:[id])
 commission Commission?
 review Review?
 @@index([designerId,status])
}
model Review {
 id String @id @default(cuid())
 requestId String @unique
 rating Int
 text String
 createdAt DateTime @default(now())
 request DesignerRequest @relation(fields:[requestId],references:[id])
}
model SubscriptionPlan {
 id String @id @default(cuid())
 name String
 role Role
 price Decimal @db.Decimal(12,2)
 credits Int
 durationDays Int @default(30)
 active Boolean @default(true)
 sample Boolean @default(true)
 createdAt DateTime @default(now())
 subscriptions Subscription[]
 payments Payment[]
}
model Subscription {
 id String @id @default(cuid())
 userId String
 planId String
 status String @default("ACTIVE")
 startsAt DateTime @default(now())
 expiresAt DateTime
 user User @relation(fields:[userId],references:[id])
 plan SubscriptionPlan @relation(fields:[planId],references:[id])
 @@index([userId,status])
}
model CreditWallet {
 id String @id @default(cuid())
 userId String @unique
 balance Int @default(0)
 updatedAt DateTime @updatedAt
 user User @relation(fields:[userId],references:[id])
 transactions CreditTransaction[]
}
model CreditTransaction {
 id String @id @default(cuid())
 walletId String
 amount Int
 reason String
 idempotencyKey String @unique
 generationId String?
 createdAt DateTime @default(now())
 wallet CreditWallet @relation(fields:[walletId],references:[id])
 @@index([walletId,createdAt])
}
model Payment {
 id String @id @default(cuid())
 userId String
 planId String
 amount Decimal @db.Decimal(12,2)
 credits Int
 durationDays Int
 currency String @default("AZN")
 provider String @default("MANUAL")
 providerReference String? @unique
 status PaymentStatus @default(PENDING)
 idempotencyKey String @unique
 createdAt DateTime @default(now())
 confirmedAt DateTime?
 user User @relation(fields:[userId],references:[id])
 plan SubscriptionPlan @relation(fields:[planId],references:[id])
 @@index([userId,status])
}
model Commission {
 id String @id @default(cuid())
 requestId String @unique
 rate Decimal @db.Decimal(5,2)
 amount Decimal @db.Decimal(12,2)
 status String @default("RECORDED")
 createdAt DateTime @default(now())
 request DesignerRequest @relation(fields:[requestId],references:[id])
}
model AnalyticsEvent {
 id String @id @default(cuid())
 productId String?
 kind String
 actorHash String?
 metadata Json?
 createdAt DateTime @default(now())
 product Product? @relation(fields:[productId],references:[id])
 @@index([productId,kind,createdAt])
 @@index([kind,createdAt])
}
model Notification {
 id String @id @default(cuid())
 userId String
 title String
 body String
 readAt DateTime?
 createdAt DateTime @default(now())
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 @@index([userId,readAt])
}
model AuditLog {
 id String @id @default(cuid())
 actorId String
 action String
 targetId String
 metadata Json?
 createdAt DateTime @default(now())
 actor User @relation(fields:[actorId],references:[id])
 @@index([actorId,createdAt])
}
model SystemSetting {
 key String @id
 value Json
 updatedAt DateTime @updatedAt
}
model Report {
 id String @id @default(cuid())
 userId String
 targetType String
 targetId String
 reason String
 resolved Boolean @default(false)
 createdAt DateTime @default(now())
 user User @relation(fields:[userId],references:[id])
}
model RateLimitBucket {
 key String @id
 count Int
 expiresAt DateTime
 @@index([expiresAt])
}

model RoomDesign {
 id String @id @default(cuid())
 userId String
 backgroundImageId String
 title String
 backgroundKind String @default("ORIGINAL")
 scene Json
 version Int @default(1)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 background ImageAsset @relation(fields:[backgroundImageId],references:[id])
 @@index([userId,updatedAt])
}
